# API Configuration
# Backend API base URL
REACT_APP_API_BASE_URL=http://localhost:8000

# User Configuration
# Default user ID for the application
REACT_APP_USER_ID=demo-user

# Authentication
# JWT bearer token issued by the backend. Required for all authenticated endpoints.
# 운영 환경에서는 k8s 환경변수로 주입되어 entrypoint.sh가 window.__ENV__.JWT_TOKEN 으로 전달.
REACT_APP_JWT_TOKEN=...